[Unit]
Description=Signal Nexus Analytics importer
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/signal-nexus
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/analytics.env
ExecStart=/home/ubuntu/signal-nexus/.venv/bin/python -m app.analytics.importer
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
