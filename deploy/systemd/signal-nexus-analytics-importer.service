[Unit]
Description=Signal Nexus Analytics importer
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@CORE_DIRECTORY@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=@ENV_DIRECTORY@/analytics.env
ExecStart=@CORE_DIRECTORY@/.venv/bin/python -m app.analytics.importer
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
